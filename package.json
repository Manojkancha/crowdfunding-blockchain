{"name": "crowdfunding-blockchain","version": "1.0.0","description": "Full-stack crowdfunding app using blockchain","scripts": {"dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"","dev:backend": "cd backend && npm run dev","dev:frontend": "cd frontend && npm start","build:contracts": "cd contracts && npx hardhat compile","deploy:contracts": "cd contracts && npx hardhat run scripts/deploy.js --network sepolia"},"devDependencies": {"concurrently": "^8.2.0"}}